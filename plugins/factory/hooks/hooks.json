{
  "description": "claude-factory: 2-fail hard stop, human-only reset (type cf-reset), never merge; TypeScript mod draws the factory pane",
  "modules": ["./register.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/cf-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/cf-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
